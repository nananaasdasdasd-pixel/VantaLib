    self._contentArea = Theme.Create("Frame", {
        Name = "ContentArea",
        Size = UDim2.new(1, -Theme.Sizes.SidebarWidth, 1, -(Theme.Sizes.HeaderHeight + Theme.Sizes.FooterHeight)),
