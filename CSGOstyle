            BackgroundColor3 = Theme.Colors.Surface,
            BorderSizePixel = 0,
            Text = tostring(math.round(({ defaultColor.R, defaultColor.G, defaultColor.B })[i] * 255)),
            TextColor3 = Theme.Colors.Text,
            Font = Theme.Font.Family,
            TextSize = Theme.Font.SizeSmall,
            TextXAlignment = Enum.TextXAlignment.Center,
            ClearTextOnFocus = false,
            ZIndex = 102,
            Parent = rgbRow,
        })
        Theme.ApplyBorder(rgbBox, Theme.Colors.Border)
        rgbBoxes[i] = rgbBox
    end
    self._rgbBoxes = rgbBoxes

    -- ===== HEX INPUT =====
    local hexRow = Theme.Create("Frame", {
        Name = "HexRow",
        Size = UDim2.new(0, canvasSize + hueBarWidth + Theme.Spacing.Small, 0, 22),
        Position = UDim2.new(0, 0, 0, canvasSize + Theme.Spacing.Medium + 26),
        BackgroundTransparency = 1,
        ZIndex = 101,
        Parent = panel,
    })

    local hexLabel = Theme.Create("TextLabel", {
        Name = "HexLabel",
        Size = UDim2.new(0, 20, 0, 22),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        Text = "#",
        TextColor3 = Theme.Colors.TextDim,
        Font = Theme.Font.Family,
        TextSize = Theme.Font.SizeSmall,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = 102,
        Parent = hexRow,
    })

    local hexBox = Theme.Create("TextBox", {
        Name = "HexBox",
        Size = UDim2.new(0, 60, 0, 18),
        Position = UDim2.new(0, 16, 0, 2),
        BackgroundColor3 = Theme.Colors.Surface,
        BorderSizePixel = 0,
