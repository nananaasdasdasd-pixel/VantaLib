        Name = "Sidebar",
        Size = UDim2.new(0, Theme.Sizes.SidebarWidth, 1, -(Theme.Sizes.HeaderHeight + Theme.Sizes.FooterHeight)),
        Position = UDim2.new(0, 0, 0, Theme.Sizes.HeaderHeight),
