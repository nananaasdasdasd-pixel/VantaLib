--------------------------------------------------------------------------------
-- Connection / cleanup helpers
--------------------------------------------------------------------------------

function Loader:_connect(signal: RBXScriptSignal, fn: (...any) -> ())
    local conn = signal:Connect(fn)
    table.insert(self._connections, conn)
    return conn
end

function Loader:_trackTween(t: Tween)
    table.insert(self._tweens, t)
    return t
end

--------------------------------------------------------------------------------
-- Connection status indicator
--------------------------------------------------------------------------------

function Loader:_updateConnectionStatus()
    -- Simple heuristic: if we can reach the server we're "connected"
    local isConnected = game:GetService("NetworkClient") ~= nil
    if isConnected then
        local greenHex = string.format("#%02X%02X%02X",
            math.floor(Theme.Colors.Success.R * 255 + 0.5),
            math.floor(Theme.Colors.Success.G * 255 + 0.5),
            math.floor(Theme.Colors.Success.B * 255 + 0.5))
        self._connectedLabel.Text = string.format('<font color="%s">●</font> Connected', greenHex)
    else
        local redHex = string.format("#%02X%02X%02X",
            math.floor(Theme.Colors.Error.R * 255 + 0.5),
            math.floor(Theme.Colors.Error.G * 255 + 0.5),
            math.floor(Theme.Colors.Error.B * 255 + 0.5))
        self._connectedLabel.Text = string.format('<font color="%s">●</font> Offline', redHex)
    end
end

--------------------------------------------------------------------------------
-- Show / Hide
--------------------------------------------------------------------------------

function Loader:Show()
    if self._destroyed then return end
    self._screenGui.Enabled = true

    -- Reset transparencies to fully invisible
    self._overlay.BackgroundTransparency = 1
    self._panel.BackgroundTransparency = 1
    self._panelStroke.Transparency = 1

    for _, el in ipairs(self._fadeElements) do
        if el:IsA("TextButton") then
            el.BackgroundTransparency = 1
            el.TextTransparency = 1
        elseif el:IsA("TextBox") then
            el.TextTransparency = 1
        elseif el:IsA("TextLabel") then
            el.TextTransparency = 1
        end
    end
    for _, fr in ipairs(self._fadeFrames) do
        fr.BackgroundTransparency = 1
    end
    for _, st in ipairs(self._fadeStrokes) do
        st.Transparency = 1
    end

    -- Animate in
    local duration = 0.4
    local style = Theme.Animation.EaseStyle
    local dir = Enum.EasingDirection.Out

    tween(self._overlay, duration, {BackgroundTransparency = 0.5}, style, dir)
    tween(self._panel, duration, {BackgroundTransparency = 0}, style, dir)
    tween(self._panelStroke, duration, {Transparency = 0}, style, dir)

    for _, el in ipairs(self._fadeElements) do
        if el:IsA("TextButton") then
            tween(el, duration, {BackgroundTransparency = 0, TextTransparency = 0}, style, dir)
        elseif el:IsA("TextBox") then
            tween(el, duration, {TextTransparency = 0}, style, dir)
        elseif el:IsA("TextLabel") then
            tween(el, duration, {TextTransparency = 0}, style, dir)
        end
    end
    for _, fr in ipairs(self._fadeFrames) do
        tween(fr, duration, {BackgroundTransparency = 0}, style, dir)
    end
    for _, st in ipairs(self._fadeStrokes) do
        tween(st, duration, {Transparency = 0}, style, dir)
    end

    -- Progress bar stays hidden until needed
    self._progressBg.BackgroundTransparency = 1
    self._progressFill.BackgroundTransparency = 1
    self._progressFill.Size = UDim2.new(0, 0, 1, 0)
end

function Loader:Hide(callback: (() -> ())?)
    if self._destroyed then return end

    -- Stop dot animation if running
    self:_stopDotAnimation()

    local duration = 0.5
    local style = Theme.Animation.EaseStyle
    local dir = Enum.EasingDirection.In

    tween(self._overlay, duration, {BackgroundTransparency = 1}, style, dir)
    tween(self._panel, duration, {BackgroundTransparency = 1}, style, dir)
    tween(self._panelStroke, duration, {Transparency = 1}, style, dir)

    for _, el in ipairs(self._fadeElements) do
        if el:IsA("TextButton") then
            tween(el, duration, {BackgroundTransparency = 1, TextTransparency = 1}, style, dir)
        elseif el:IsA("TextBox") then
            tween(el, duration, {TextTransparency = 1}, style, dir)
        elseif el:IsA("TextLabel") then
            tween(el, duration, {TextTransparency = 1}, style, dir)
        end
    end
    for _, fr in ipairs(self._fadeFrames) do
        tween(fr, duration, {BackgroundTransparency = 1}, style, dir)
    end
    for _, st in ipairs(self._fadeStrokes) do
        tween(st, duration, {Transparency = 1}, style, dir)
    end

    task.delay(duration + 0.05, function()
        if not self._destroyed then
            self._screenGui.Enabled = false
        end
        if callback then
            callback()
        end
    end)
end

function Loader:Destroy()
    if self._destroyed then return end
    self._destroyed = true

    self:_stopDotAnimation()
    self:_stopProgressAnimation()

    for _, conn in ipairs(self._connections) do
        conn:Disconnect()
    end
    self._connections = {}

    for _, t in ipairs(self._tweens) do
        t:Cancel()
    end
    self._tweens = {}

    if self._screenGui then
        self._screenGui:Destroy()
        self._screenGui = nil
    end
end

--------------------------------------------------------------------------------
-- Status helpers
--------------------------------------------------------------------------------

function Loader:_setStatus(text: string, color: Color3)
    self._statusLabel.Text = text
    self._statusLabel.TextColor3 = color
end

function Loader:_startDotAnimation()
    self:_stopDotAnimation()
    local dotCount = 0
    self._dotRunning = true
    self._dotThread = task.spawn(function()
        while self._dotRunning and not self._destroyed do
            dotCount = (dotCount % 3) + 1
            local dots = string.rep(".", dotCount)
            self._statusLabel.Text = "Verifying" .. dots
            task.wait(0.35)
        end
    end)
end

function Loader:_stopDotAnimation()
    self._dotRunning = false
    if self._dotThread then
        task.cancel(self._dotThread)
        self._dotThread = nil
    end
end

--------------------------------------------------------------------------------
-- Progress bar helpers
--------------------------------------------------------------------------------

function Loader:_showProgress()
    self._progressBg.BackgroundTransparency = 0
    self._progressFill.BackgroundTransparency = 0
    self._progressFill.Size = UDim2.new(0, 0, 1, 0)
    self._progressFill.BackgroundColor3 = Theme.Colors.Accent
    self:_startProgressAnimation()
end

function Loader:_startProgressAnimation()
    self:_stopProgressAnimation()
    self._progressAnimRunning = true
    self._progressThread = task.spawn(function()
        while self._progressAnimRunning and not self._destroyed do
            -- Sweep left to right
            self._progressFill.Size = UDim2.new(0, 0, 1, 0)
            self._progressFill.Position = UDim2.new(0, 0, 0, 0)
            local t1 = tween(self._progressFill, 0.6, {Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.new(0, 0, 0, 0)})
            t1.Completed:Wait()
            if not self._progressAnimRunning then break end
            local t2 = tween(self._progressFill, 0.6, {Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 0, 1, 0)})
            t2.Completed:Wait()
            if not self._progressAnimRunning then break end
        end
    end)
end

function Loader:_stopProgressAnimation()
    self._progressAnimRunning = false
    if self._progressThread then
        task.cancel(self._progressThread)
        self._progressThread = nil
    end
end

function Loader:_progressSuccess()
    self:_stopProgressAnimation()
    self._progressFill.Position = UDim2.new(0, 0, 0, 0)
    self._progressFill.BackgroundColor3 = Theme.Colors.Success
    tween(self._progressFill, 0.3, {Size = UDim2.new(1, 0, 1, 0)})
end

function Loader:_progressFail()
    self:_stopProgressAnimation()
    self._progressFill.Position = UDim2.new(0, 0, 0, 0)
    self._progressFill.BackgroundColor3 = Theme.Colors.Error
    local t = tween(self._progressFill, 0.3, {Size = UDim2.new(1, 0, 1, 0)})
    task.delay(1.2, function()
        if not self._destroyed then
            tween(self._progressBg, 0.2, {BackgroundTransparency = 1})
            tween(self._progressFill, 0.2, {BackgroundTransparency = 1})
        end
    end)
end

function Loader:_hideProgress()
    self:_stopProgressAnimation()
    tween(self._progressBg, 0.2, {BackgroundTransparency = 1})
    tween(self._progressFill, 0.2, {BackgroundTransparency = 1})
end

--------------------------------------------------------------------------------
-- Input shake animation
--------------------------------------------------------------------------------

function Loader:_shakeInput()
    local frame = self._inputFrame
    local originalPos = frame.Position
    local offsetPx = 3
    local cycleDuration = 0.05

    task.spawn(function()
        for _ = 1, 3 do
            if self._destroyed then return end
            local t1 = tween(frame, cycleDuration, {
                Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset + offsetPx, originalPos.Y.Scale, originalPos.Y.Offset)
            }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            t1.Completed:Wait()
            local t2 = tween(frame, cycleDuration, {
                Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset - offsetPx, originalPos.Y.Scale, originalPos.Y.Offset)
            }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            t2.Completed:Wait()
        end
        -- Return to original
        tween(frame, cycleDuration, {Position = originalPos}, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    end)
end

