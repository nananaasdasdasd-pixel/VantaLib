_M["Components_Toggle"] = (function()
--[[
    Toggle.lua
    CS:GO-style compact rectangular toggle switch component.
    Part of CSGOLib UI Library.

    Usage:
        local toggle = Toggle.new(parent, {
            Name = "Enable Feature",
            Default = false,
