    })

    -- Description text (if provided)
    if hasDescription then
        Theme.Create("TextLabel", {
            Name = "Description",
            Size = UDim2.new(1, -(Theme.Sizes.ToggleWidth + Theme.Spacing.Medium), 0, Theme.Font.SizeTiny + Theme.Spacing.Tiny),
            Position = UDim2.new(0, 0, 0, Theme.Sizes.ControlHeight),
            BackgroundTransparency = 1,
