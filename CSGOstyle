local function healthColor(pct: number): Color3
    if pct >= 60 then
        return Theme.Colors.Health
    elseif pct >= 30 then
        return Theme.Colors.HealthMid
    else
        return Theme.Colors.HealthLow
    end
end

local function distanceFromScale(scale: number): number
    -- Larger scale = closer = smaller distance
    return math.floor(10 + (1.0 - scale) * 80 + 0.5)
end

--- Create a thin line Frame between two pixel offsets relative to a common parent.
--- (x1, y1) and (x2, y2) are pixel coordinates inside the parent.
local function createLine(parent: Frame, x1: number, y1: number, x2: number, y2: number, color: Color3, transparency: number): Frame
    local dx = x2 - x1
    local dy = y2 - y1
    local length = math.sqrt(dx * dx + dy * dy)
    local angle = math.deg(math.atan2(dy, dx))
    local mx = (x1 + x2) / 2
    local my = (y1 + y2) / 2

    local line = Theme.Create("Frame", {
        Name = "SkeletonLine",
        Parent = parent,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, mx, 0, my),
        Size = UDim2.new(0, math.max(1, math.floor(length + 0.5)), 0, 1),
        Rotation = angle,
        BackgroundColor3 = color,
        BackgroundTransparency = transparency,
        BorderSizePixel = 0,
    })
    return line
end

--------------------------------------------------------------------------------
-- ESPPreview Module
--------------------------------------------------------------------------------

local ESPPreview = {}
