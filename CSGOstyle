        Name = "Input",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 104,
        Parent = svCanvas,
    })

    -- ===== HUE BAR =====
    local hueBar = Theme.Create("Frame", {
        Name = "HueBar",
